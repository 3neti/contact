{
    "name": "3neti/contact",
    "description": "A package to enable assigning contacts to Eloquent Models",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lester Hurtado",
            "email": "lester@hurtado.ph"
        }
    ],
    "autoload": {
        "psr-4": {
            "LBHurtado\\Contact\\": "src/",
            "LBHurtado\\Contact\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\Contact\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\Contact\\ContactServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-data": "^4.17",
        "propaganistas/laravel-phone": "^6.0",
        "spatie/laravel-schemaless-attributes": "^2.5",
        "3neti/hyperverge": "^1.1 || ^2.0@beta",
        "spatie/laravel-medialibrary": "^11.21"
    },
    "require-dev": {
        "3neti/laravel-model-input": "^v1.0",
        "orchestra/testbench": "^9.15 || ^10.3 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
